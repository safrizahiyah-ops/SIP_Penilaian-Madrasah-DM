      "properties": {
        "teacherId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "phone": { "type": "string", "maxLength": 40 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "phone", "updatedBy", "createdAt", "updatedAt"]
    },
    "Judge": {
      "title": "Judge",
      "description": "Master data for Penilai I and Penilai II.",
