        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "weekNumber", "globalWeekNumber", "month", "year", "academicYear", "scheduledDate", "ceremonyDate", "theme", "status", "readerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "Evaluation": {
      "title": "Evaluation",
      "description": "Lampiran 1 weekly classroom evaluation sheet by a single judge.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "periodId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "weekNumber": { "type": "number" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "evaluationDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "className": { "type": "string", "minLength": 1, "maxLength": 80 },
        "homeroomTeacherName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "theme": { "type": "string", "minLength": 1, "maxLength": 160 },
        "judgeId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "judgeName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "judgeNumber": { "type": "string", "enum": ["I", "II"] },
        "scores": { "type": "object" },
        "itemNotes": { "type": "object" },
        "subtotalA": { "type": "number" },
        "subtotalB": { "type": "number" },
        "subtotalC": { "type": "number" },
        "subtotalD": { "type": "number" },
        "totalScore": { "type": "number" },
        "generalNote": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["DRAFT", "FINAL", "LOCKED"] },
        "revisionCount": { "type": "number" },
        "readerUids": { "type": "array" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "periodId", "weekNumber", "month", "year", "evaluationDate", "classId", "className", "homeroomTeacherName", "theme", "judgeId", "judgeName", "judgeNumber", "scores", "itemNotes", "subtotalA", "subtotalB", "subtotalC", "subtotalD", "totalScore", "generalNote", "status", "revisionCount", "readerUids", "createdBy", "updatedBy", "createdAt", "updatedAt"]
    },
    "EvaluationItem": {
      "title": "EvaluationItem",
      "description": "Individual scored rubric item linked to an Evaluation.",
