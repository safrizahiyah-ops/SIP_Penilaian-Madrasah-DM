{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public staff profile and role assignment for SIP-KELAS Darul Mahfudz.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["administrator", "penilai", "koordinator", "kepala_madrasah", "viewer"] },
        "judgeSlot": { "type": "string", "enum": ["NONE", "I", "II"] },
        "linkedJudgeId": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "readerUids": { "type": "array", "description": "Bounded list of authorized reader UIDs (max 50)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "judgeSlot", "linkedJudgeId", "active", "readerUids", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII (email and phone) for a user account.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "phone", "createdAt", "updatedAt"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Master data for classes participating in the competition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 1, "maxLength": 30 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "grade": { "type": "string", "enum": ["X", "XI", "XII"] },
        "homeroomTeacherId": { "type": "string", "maxLength": 128 },
        "homeroomTeacherName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "active": { "type": "boolean" },
        "readerUids": { "type": "array" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
