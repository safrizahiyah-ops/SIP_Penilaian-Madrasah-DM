        "readerUids": { "type": "array" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "position", "identityNumber", "judgeRole", "linkedUserUid", "active", "readerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "JudgingPeriod": {
      "title": "JudgingPeriod",
      "description": "Weekly judging schedule and thematic configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "weekNumber": { "type": "number" },
        "globalWeekNumber": { "type": "number" },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "academicYear": { "type": "string", "minLength": 4, "maxLength": 20 },
        "scheduledDate": { "type": "string", "minLength": 10, "maxLength": 10 },
        "ceremonyDate": { "type": "string", "maxLength": 10 },
        "theme": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "type": "string", "enum": ["SCHEDULED", "OPEN", "CLOSED"] },
        "readerUids": { "type": "array" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
