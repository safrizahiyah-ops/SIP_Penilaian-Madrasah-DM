      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "nip": { "type": "string", "maxLength": 50 },
        "assignedClassId": { "type": "string", "maxLength": 64 },
        "assignedClassName": { "type": "string", "maxLength": 80 },
        "active": { "type": "boolean" },
        "readerUids": { "type": "array" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "nip", "assignedClassId", "assignedClassName", "active", "readerUids", "createdBy", "createdAt", "updatedAt"]
    },
    "TeacherContact": {
      "title": "TeacherContact",
      "description": "Isolated contact phone numbers for homeroom teachers.",
